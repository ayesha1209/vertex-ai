OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-5-mini-2025-08-07

MONGODB_URI=mongodb+srv://username:password@cluster-url/?retryWrites=true&w=majority
MONGODB_DB_NAME=vertex_ai

# Comma-separated list of allowed frontend origins
# Example for local dev:
ALLOWED_ORIGINS=http://localhost:5173

# Admin dashboard login (shipment tracking). Single shared password — whoever
# knows it can log in as "admin". Required: login always fails if unset.
AUTH_PASSWORD=choose-a-strong-password

# Microsoft Graph email sending (app-only/client-credentials OAuth) — needed
# for the "Send Emails" feature. Create an Azure AD app registration with
# Mail.Send (application) permission granted, then fill these in from it.
MS_TENANT_ID=your-azure-ad-tenant-id
MS_CLIENT_ID=your-azure-ad-app-client-id
MS_CLIENT_SECRET=your-azure-ad-app-client-secret

# Comma-separated list of mailbox addresses allowed as the "From" sender when
# emailing generated documents. Each address needs a mailbox in the same
# Microsoft 365 tenant as MS_TENANT_ID above. Leave empty to disable sending
# (the Send Emails feature stays inert with no senders to pick).
SENDER_EMAILS=sales@yourcompany.com

